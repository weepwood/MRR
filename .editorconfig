# ===================================================================
# EditorConfig — 跨编辑器统一编码规范
# 详见 https://editorconfig.org
# ===================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# ---- 后端 Java ----
[*.java]
indent_size = 4

[*.xml]
indent_size = 4

[*.properties]
indent_size = 4

# ---- 前端 Vue/TS/JS ----
[*.{vue,ts,tsx,js,jsx,cjs,mjs}]
indent_size = 2

[*.{css,scss,less}]
indent_size = 2

[*.{json,jsonc,json5}]
indent_size = 2

# ---- 文档与配置 ----
[*.{md,mdx,yaml,yml,toml}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab

# ---- 数据库 ----
[*.sql]
indent_size = 4

# ---- Docker ----
[Dockerfile]
indent_size = 4

# ---- Git 配置 ----
[.gitignore]
indent_size = 2

[.gitattributes]
indent_size = 2

[.editorconfig]
indent_size = 2
