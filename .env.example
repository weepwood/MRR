# Copy to .env before starting Docker Compose. Do not commit .env.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_MONITOR_PASSWORD=replace-with-a-different-read-only-monitor-password
AES_SECRET_KEY=replace-with-a-random-32-byte-secret
JWT_SECRET_KEY=replace-with-a-random-jwt-signing-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
PROMETHEUS_RETENTION=30d

# Data quality schedule (Spring cron syntax, default daily at 02:15)
APP_DATA_QUALITY_ENABLED=true
APP_DATA_QUALITY_CRON=0 15 2 * * ?
APP_DATA_QUALITY_SAMPLE_LIMIT=200
APP_DATA_QUALITY_RETENTION_DAYS=90
