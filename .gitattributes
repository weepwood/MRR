# 默认所有文本文件使用 LF 行尾
* text=auto eol=lf

# 源码文件
*.java text eol=lf
*.vue text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.md text eol=lf

# 配置文件
*.toml text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Shell 脚本需要 LF（Windows 下 CRLF 会导致 bash 无法执行）
*.sh text eol=lf
*.py text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.jar binary
*.zip binary
*.gz binary
*.br binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.class binary
