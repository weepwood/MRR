{
  "name": "pmr",
  "private": true,
  "version": "0.0.7",
  "type": "module",
  "scripts": {
    "predev": "npm run docs:build",
    "dev": "vite",
    "prebuild": "npm run docs:build",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs --host",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host",
    "lint": "eslint src --ext .js,.vue",
    "lint:fix": "eslint src --ext .js,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\" \"*.{js,json,md}\"",
    "preview": "vite preview",
    "server": "node server/index.js",
    "dev:server": "nodemon server/index.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "element-plus": "^2.11.1",
    "express": "^4.18.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "viewerjs": "^1.11.6",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.6",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.1.1",
    "vue-tsc": "^3.2.6"
  }
}
